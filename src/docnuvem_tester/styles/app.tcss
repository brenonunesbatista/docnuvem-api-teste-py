/* ---------------------------------------------------------------------
   Visual moderno e limpo: tema escuro definido em theme.py. As cores vêm
   das variáveis do tema ($primary, $surface, $panel, $border, ...), então
   ficam fixas independente do tema do terminal do usuário.
   ------------------------------------------------------------------- */

Screen {
    background: $background;
    color: $foreground;
}

/* Modais deixam a tela de baixo levemente visível, em vez de cobri-la. */
ModalScreen {
    background: $background 75%;
}

/* ------------------------------ Banner -------------------------------- */

BannerScreen {
    align: center middle;
}

/* Um único Static com width: auto: ao lado de um irmão de largura 100% o
   Textual desalinharia o centro (vira x=0 em vez de centralizado). */
#banner-art {
    text-align: center;
    width: auto;
}


/* ----------------------------- Barra de menu ---------------------------- */

MenuBar {
    dock: top;
    height: 3;
    padding: 0 2;
    background: $surface;
    align: left middle;
}

#menu-brand {
    width: auto;
    height: 1;
    padding: 0 3 0 0;
}

MenuBar Button {
    background: transparent;
    color: $text-muted;
    border: none;
    height: 1;
    min-width: 0;
    padding: 0 2;
    margin: 0 1 0 0;
    text-style: none;
}

MenuBar Button:hover {
    background: $panel;
    color: $foreground;
}

MenuBar Button:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

/* --------------------------------- Rodapé -------------------------------- */

Footer {
    background: $surface;
}

/* ------------------------------- Cartões --------------------------------- */

.card {
    background: $surface;
    border: round $border;
    padding: 1 2;
}

.card-title {
    color: $foreground;
    text-style: bold;
    width: 100%;
    margin-bottom: 1;
}

/* --------------------------- Menu de categoria --------------------------- */

CategoryScreen > .card {
    width: 70;
    height: auto;
    max-height: 80%;
}

CategoryScreen ListView {
    background: transparent;
    height: auto;
    max-height: 20;
}

CategoryScreen ListItem {
    background: transparent;
    color: $foreground;
    padding: 0 1;
}

/* ------------------------------ Tela inicial ----------------------------- */

MainMenuScreen {
    align: center middle;
}

#home {
    width: 64;
    height: auto;
}

#home .card-title {
    text-align: center;
}

#perfil-ativo {
    color: $success;
    text-align: center;
}

#main-menu-hint {
    color: $text-muted;
    text-align: center;
    margin-top: 2;
}

/* -------------------------------- Formulários ---------------------------- */

FormScreen > .card {
    width: 90%;
    max-width: 100;
    height: auto;
    max-height: 90%;
}

.form-row {
    height: auto;
    margin-bottom: 1;
}

.form-label {
    width: 28;
    color: $text-muted;
    padding-top: 1;
}

.form-row Input {
    width: 1fr;
}

.form-row Select {
    width: 1fr;
}

.form-row Checkbox {
    width: 1fr;
}

.form-row Button {
    margin-left: 1;
}

.form-hint {
    color: $text-muted;
    margin-bottom: 1;
}

.form-actions {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.form-actions Button {
    margin-left: 1;
}

/* --------------------------------- Campos -------------------------------- */

Input {
    background: $panel;
    color: $foreground;
    border: round $border;
    height: 3;
    padding: 0 1;
}

Input:focus {
    border: round $primary;
    background: $panel;
    background-tint: transparent;
}

Input.-invalid,
Input.-invalid:focus {
    border: round $error;
}

.inline-erros {
    color: $error;
    height: auto;
    margin-top: 1;
}

Input:disabled {
    background: $surface;
    color: $text-muted;
}

TextArea {
    background: $panel;
    color: $foreground;
    border: round $border;
}

TextArea:focus {
    border: round $primary;
}

SelectCurrent {
    background: $panel;
    border: round $border;
}

Select:focus > SelectCurrent {
    border: round $primary;
}

SelectOverlay {
    background: $surface;
    border: round $border;
}

ToggleButton {
    background: transparent;
    border: none;
    padding: 0 1;
}

Switch {
    background: $panel;
    border: round $border;
}

Switch:focus {
    border: round $primary;
}

/* -------------------------------- Botões --------------------------------- */

Button {
    background: $panel;
    color: $foreground;
    border: none;
    height: 3;
    min-width: 12;
    text-style: none;
}

Button:hover {
    background: $border;
}

Button:focus {
    background: $border;
    text-style: bold;
}

Button.primary {
    background: $primary;
    color: $background;
    text-style: bold;
}

Button.primary:hover,
Button.primary:focus {
    background: $primary-lighten-2;
}

Button.danger {
    background: $error;
    color: $background;
    text-style: bold;
}

Button.danger:hover,
Button.danger:focus {
    background: $error-lighten-2;
}

/* -------------------- Variáveis de modelo (from-template) ----------------- */

.var-row {
    height: auto;
    margin-bottom: 1;
    border: round $border;
    padding: 0 1;
}

.var-row.-campo-erro {
    border: round $error;
}

.var-label {
    color: $foreground;
    text-style: bold;
}

.var-row TextArea {
    height: 5;
}

/* ---------------------- Editor dinâmico de signatários -------------------- */

DynamicListEditor {
    height: auto;
    border: round $border;
    padding: 1;
    margin-bottom: 1;
}

DynamicListEditor .dyn-row {
    height: auto;
    margin-bottom: 1;
}

DynamicListEditor .dyn-row Input {
    width: 1fr;
}

DynamicListEditor .dyn-row Button {
    margin-left: 1;
}

/* ------------------------------- Resultado --------------------------------- */

ResultScreen > .card {
    width: 95%;
    height: 90%;
}

ResultScreen.-error > .card {
    border: round $error;
}

ResultScreen.-error .card-title {
    color: $error;
}

.result-body {
    height: 1fr;
    background: $background;
    border: round $border;
}

ResultScreen.-error .result-body {
    border: round $error;
}

.result-body TextArea {
    background: $background;
    border: none;
}

StatusResultScreen > .card,
DownloadResultScreen > .card,
CriarDocumentoResultScreen > .card {
    width: 90%;
    max-width: 110;
    height: auto;
    max-height: 90%;
}

StatusResultScreen DataTable {
    height: auto;
    max-height: 14;
    margin-top: 1;
}

#result-tabs {
    height: 1fr;
}

#result-tabs TabPane {
    padding: 0;
}

.result-copy-bar {
    height: auto;
    margin: 1 0;
}

.result-copy-bar Button {
    margin-right: 1;
}

.result-hint {
    color: $text-muted;
    margin-top: 1;
}

.alert-message {
    color: $warning;
    margin-bottom: 1;
}

/* --------------------------------- Tabelas --------------------------------- */

DataTable {
    background: $surface;
    color: $foreground;
}

DataTable > .datatable--header {
    background: $panel;
    color: $text-muted;
    text-style: bold;
}

/* -------------------------------- Confirmação ------------------------------ */

ConfirmScreen > .card {
    width: 60;
    height: auto;
}

ConfirmScreen .confirm-message {
    margin-bottom: 1;
}

ConfirmScreen .confirm-actions {
    height: auto;
    align-horizontal: center;
}

ConfirmScreen .confirm-actions Button {
    margin: 0 1;
}

/* ---------------------------------- Alerta ---------------------------------- */

AlertScreen > .card {
    width: 70;
    height: auto;
    border: round $warning;
}

AlertScreen .card-title {
    color: $warning;
}

/* ----------------------------------- Ajuda ---------------------------------- */

HelpScreen > .card {
    width: 76;
    height: auto;
    max-height: 90%;
}

/* ------------------------------ Log de chamadas ----------------------------- */

CallLogScreen > .card {
    width: 95%;
    height: 90%;
}

CallLogScreen DataTable {
    height: 1fr;
}

/* --------------------------- Seletor de arquivo nativo ---------------------- */

FilePickerModal > .card {
    width: 90%;
    height: 80%;
}

FilePickerModal DirectoryTree {
    height: 1fr;
    background: $surface;
}

/* ------------------------------ LoadingIndicator ----------------------------- */

LoadingIndicator {
    background: transparent;
    color: $primary;
}
